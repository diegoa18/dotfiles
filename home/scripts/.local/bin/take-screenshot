#!/bin/bash
set -euo pipefail

pkill slurp || true

XDG_PICTURES_DIR="${XDG_PICTURES_DIR:-$HOME/Pictures}"
SCREENSHOT_DIR="$XDG_PICTURES_DIR/Screenshots"
mkdir -p "$SCREENSHOT_DIR"
file="$SCREENSHOT_DIR/screenshot-$(date +%Y-%m-%d_%H-%M-%S).png"

if ~/.local/bin/grimblast --freeze copysave area "$file" >/dev/null 2>&1; then
    notify-send "Screenshot" "Captura guardada en $file"
else
    rm -f "$file"
    exit 1
fi
