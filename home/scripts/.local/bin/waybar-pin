#!/bin/bash
set -euo pipefail

CONFIG_FILE="$HOME/.config/waybar/config.jsonc"

if [ "$#" -lt 2 ]; then exit 1; fi

ACTION="$1"
MODULE="$2"
TMP_FILE="${CONFIG_FILE}.tmp"

HAS_MODULE=$(jq -e ".[\"modules-right\"] | index(\"$MODULE\")" "$CONFIG_FILE" >/dev/null && echo "true" || echo "false")

# Lógica maestra: Inyectar SIEMPRE justo antes de 'custom/controlcenter'
JQ_FILTER_PIN='
  .["modules-right"] as $arr |
  ($arr | index("custom/controlcenter")) as $idx |
  if $idx != null then
    .["modules-right"] = $arr[:$idx] + ["'"$MODULE"'"] + $arr[$idx:]
  else
    .["modules-right"] += ["'"$MODULE"'"]
  end
'

JQ_FILTER_UNPIN='.["modules-right"] -= ["'"$MODULE"'"]'

case "$ACTION" in
    pin)
        [ "$HAS_MODULE" = "true" ] && exit 0
        jq "$JQ_FILTER_PIN" "$CONFIG_FILE" > "$TMP_FILE"
        ;;
    unpin)
        [ "$HAS_MODULE" = "false" ] && exit 0
        jq "$JQ_FILTER_UNPIN" "$CONFIG_FILE" > "$TMP_FILE"
        ;;
    toggle)
        if [ "$HAS_MODULE" = "true" ]; then
            jq "$JQ_FILTER_UNPIN" "$CONFIG_FILE" > "$TMP_FILE"
        else
            jq "$JQ_FILTER_PIN" "$CONFIG_FILE" > "$TMP_FILE"
        fi
        ;;
    *) exit 1 ;;
esac

cat "$TMP_FILE" > "$CONFIG_FILE" && rm "$TMP_FILE"
killall -USR2 waybar
