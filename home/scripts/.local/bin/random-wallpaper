#!/bin/bash

set -u

WALLPAPER_DIR="$HOME/Pictures/wallpaper"
CURRENT="$WALLPAPER_DIR/current"

mkdir -p "$WALLPAPER_DIR"

wallpaper="$(
    find "$WALLPAPER_DIR" \
        -maxdepth 1 \
        -type f \
        \( \
            -iname '*.jpg' -o \
            -iname '*.jpeg' -o \
            -iname '*.png' -o \
            -iname '*.webp' \
        \) \
        -print0 |
        shuf -z -n 1 |
        tr -d '\0'
)"

if [ -z "$wallpaper" ]; then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send \
            "Wallpaper" \
            "No wallpapers found in $WALLPAPER_DIR"
    fi

    exit 0
fi

ln -sfn "$wallpaper" "$CURRENT"

if pgrep -x hyprpaper >/dev/null; then
    pkill -x hyprpaper
    sleep 0.2
fi

hyprpaper >/dev/null 2>&1 &

if command -v notify-send >/dev/null 2>&1; then
    notify-send \
        "Wallpaper" \
        "$(basename "$wallpaper")"
fi
