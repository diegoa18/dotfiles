#!/bin/bash
set -euo pipefail

# 1. Detección: Buscamos si ya existe ALGUIEN en el workspace especial (sea cual sea su nombre real)
if hyprctl clients -j | grep -q 'special:scratchpad'; then
    # Si existe, lo ocultamos/mostramos
    hyprctl dispatch 'hl.dsp.workspace.toggle_special("scratchpad")'
else
    # 2. Creación: Usamos las reglas directas Y el --class para evitar que se fusione con tus otras terminales
    hyprctl dispatch 'hl.dsp.exec_cmd("[workspace special:scratchpad; float; size 1000 650; center] ghostty --class=ghostty-scratchpad")'
fi
