#!/bin/bash
set -euo pipefail

# Verificamos si ya existe alguna ventana guardada en el scratchpad
if hyprctl clients -j | grep -q 'special:scratchpad'; then
    # Si existe, la mostramos/ocultamos como un interruptor
    hyprctl dispatch "'togglespecialworkspace', 'scratchpad'"
else
    # Si no existe, forzamos a que nazca flotante, centrada y en el scratchpad directamente
    hyprctl dispatch "'exec', '[workspace special:scratchpad; float; size 1000 650; center] ghostty'"
    
    # Pequeña pausa para que Wayland registre la ventana antes de desplegarla en pantalla
    sleep 0.25
    hyprctl dispatch "'togglespecialworkspace', 'scratchpad'"
fi
