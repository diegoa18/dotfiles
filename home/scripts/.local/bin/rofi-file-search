#!/usr/bin/env bash

cd "$HOME" || exit 1

if command -v fdfind >/dev/null 2>&1; then
    FIND_CMD="fdfind . --exclude node_modules --exclude target --exclude __pycache__ --exclude .git"
elif command -v fd >/dev/null 2>&1; then
    FIND_CMD="fd . --exclude node_modules --exclude target --exclude __pycache__ --exclude .git"
else
    FIND_CMD="find . -not -path '*/.*' -not -path '*/node_modules*' | sed 's|^\./||'"
fi

SELECTED=$(eval "$FIND_CMD" | sed "s|^|~/|" | rofi -dmenu -i -p "Files" \
    -mesg "→ Open in Zed" \
    -matching fuzzy -sort -sorting-method fzf \
    -kb-move-char-forward "Control+f" \
    -kb-custom-1 "Right" \
    -wayland-layer overlay)

EXIT_CODE=$?

if [ -z "$SELECTED" ]; then
    exit 0
fi

REAL_PATH="${SELECTED/#\~/$HOME}"

open_in_zed() {
    if command -v zed >/dev/null 2>&1; then
        zed "$1" >/dev/null 2>&1 &
    elif command -v zeditor >/dev/null 2>&1; then
        zeditor "$1" >/dev/null 2>&1 &
    elif [ -x "$HOME/.local/bin/zed" ]; then
        "$HOME/.local/bin/zed" "$1" >/dev/null 2>&1 &
    elif flatpak info dev.zed.Zed >/dev/null 2>&1; then
        flatpak run dev.zed.Zed "$1" >/dev/null 2>&1 &
    else
        notify-send "Rofi File Search" "Zed binary not found"
    fi
}

# EXIT_CODE 10 = Right Arrow -> Open in Zed
if [ "$EXIT_CODE" -eq 10 ]; then
    open_in_zed "$REAL_PATH"
    exit 0
fi

# EXIT_CODE 0 = Enter -> Nautilus for directories, default app for files
if [ "$EXIT_CODE" -eq 0 ]; then
    if [ -d "$REAL_PATH" ]; then
        nautilus "$REAL_PATH" >/dev/null 2>&1 &
    else
        xdg-open "$REAL_PATH" >/dev/null 2>&1 &
    fi
fi
