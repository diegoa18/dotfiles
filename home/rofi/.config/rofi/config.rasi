configuration {
	modes: "drun,filebrowser";
	font: "JetBrains Mono 11";
	show-icons: true;
	display-drun: "Applications";
	display-filebrowser: "Files";
	drun-display-format: "{name}";
}

* {
	background-color: transparent;
	text-color: #cdd6f4;

	border-color: #ffffff18;
	separatorcolor: #ffffff14;

	selected-normal-background: #ffffff10;
	selected-normal-foreground: #cdd6f4;

	active-background: #89b4fa1c;
	active-foreground: #cdd6f4;

	urgent-background: #f38ba81c;
	urgent-foreground: #cdd6f4;
}

window {
	width: 600px;
	background-color: #080808b8;
	border: 1px;
	border-color: #ffffff18;
	border-radius: 10px;
	padding: 12px;
}

mainbox {
	children: [
		inputbar,
		message,
		listview
	];
}

inputbar {
	children: [
		prompt,
		entry
	];
	spacing: 10px;
	padding: 8px 10px;
}

prompt {
	text-color: #89b4fa;
}

entry {
	text-color: #cdd6f4;
	cursor-color: #89b4fa;
}

listview {
	lines: 10;
	spacing: 4px;
	fixed-height: false;
}

element {
	padding: 7px 9px;
	spacing: 8px;
	border-radius: 7px;
	background-color: transparent;
	text-color: #cdd6f4;
}

element normal.normal,
element normal.active,
element normal.urgent,
element alternate.normal,
element alternate.active,
element alternate.urgent {
	background-color: transparent;
	text-color: #cdd6f4;
}

element selected.normal {
	background-color: #ffffff10;
	text-color: #cdd6f4;
}

element selected.active {
	background-color: #89b4fa1c;
	text-color: #cdd6f4;
}

element selected.urgent {
	background-color: #f38ba81c;
	text-color: #cdd6f4;
}

element-text {
	background-color: transparent;
	text-color: inherit;
}

element-icon {
	background-color: transparent;
	size: 20px;
}

message {
	padding: 4px;
}

textbox {
	text-color: #7f849c;
}
