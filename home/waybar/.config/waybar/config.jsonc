{
  "layer": "top",
  "position": "top",
  "height": 24,
  "spacing": 0,
  "modules-left": [
    "custom/user",
    "mpris",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "custom/brightness",
    "pulseaudio",
    "network",
    "battery",
    "custom/controlcenter",
    "custom/power"
  ],
  "custom/user": {
    "exec": "id -un",
    "interval": "once",
    "format": "{}",
    "max-length": 15,
    "ellipsize": "end",
    "tooltip": false,
    "on-click": "~/.local/bin/system-info-popup"
  },
  "mpris": {
    "format": "♪ {artist} · {title}",
    "format-paused": "⏸ {artist} · {title}",
    "format-stopped": "",
    "max-length": 40,
    "ellipsize": "end",
    "tooltip-format": "{player}\n{artist} · {title}",
    "on-click": "~/.local/bin/mpris-popup",
    "on-click-right": "playerctl play-pause"
  },
  "hyprland/window": {
    "format": ""
  },
  "clock": {
    "format": "{:%A %d | %B · %H:%M}",
    "tooltip": false,
    "on-click": "~/.local/bin/calendar-popup"
  },
  "custom/controlcenter": {
    "format": "▼",
    "tooltip": false,
    "on-click": "~/.local/bin/control-center-popup"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "<span font_family=\"Symbols Nerd Font\">󰝟</span> Muted",
    "format-icons": {
      "default": [
        "<span font_family=\"Symbols Nerd Font\"></span>",
        "<span font_family=\"Symbols Nerd Font\"></span>",
        "<span font_family=\"Symbols Nerd Font\"></span>"
      ]
    },
    "scroll-step": 5,
    "max-volume": 100,
    "tooltip-format": "{desc}\n{volume}%",
    "on-click": "~/.local/bin/audio-popup",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-middle": "~/.local/bin/waybar-pin unpin pulseaudio"
  },
  "network": {
    "format-wifi": "<span font_family=\"Symbols Nerd Font\"></span>  {essid}",
    "format-ethernet": "<span font_family=\"Symbols Nerd Font\">󰈀</span>  {ifname}",
    "format-disconnected": "<span font_family=\"Symbols Nerd Font\">󰖪</span>",
    "max-length": 20,
    "ellipsize": "end",
    "tooltip-format-wifi": "{essid}\n{signalStrength}%\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "~/.local/bin/network-popup",
    "on-click-middle": "~/.local/bin/waybar-pin unpin network"
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "<span font_family=\"Symbols Nerd Font\"></span> {capacity}%",
    "format-plugged": "<span font_family=\"Symbols Nerd Font\"></span> {capacity}%",
    "format-full": "<span font_family=\"Symbols Nerd Font\"></span> {capacity}%",
    "format-icons": [
      "<span font_family=\"Symbols Nerd Font\"></span>",
      "<span font_family=\"Symbols Nerd Font\"></span>",
      "<span font_family=\"Symbols Nerd Font\"></span>",
      "<span font_family=\"Symbols Nerd Font\"></span>",
      "<span font_family=\"Symbols Nerd Font\"></span>"
    ],
    "tooltip-format": "{capacity}%\n{timeTo}\n{power:.1f} W",
    "on-click": "~/.local/bin/battery-popup",
    "on-click-middle": "~/.local/bin/waybar-pin unpin battery"
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "~/.local/bin/power-menu"
  },
  "custom/bluetooth": {
    "exec": "~/.local/bin/bluetooth-popup-service --waybar",
    "return-type": "json",
    "interval": "once",
    "format": "<span font_family=\"Symbols Nerd Font\"></span> {}",
    "on-click": "~/.local/bin/bluetooth-popup",
    "on-click-right": "~/.local/bin/bluetooth-popup-service --toggle",
    "on-click-middle": "~/.local/bin/waybar-pin unpin custom/bluetooth",
    "tooltip": true,
    "signal": 8
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "<span font_family=\"Symbols Nerd Font\">{icon}</span> {percent}%",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ],
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
    "on-click": "~/.local/bin/brightness-popup",
    "on-click-middle": "~/.local/bin/waybar-pin unpin backlight",
    "tooltip": true
  },
  "tray": {
    "icon-size": 18,
    "spacing": 10
  }
}
